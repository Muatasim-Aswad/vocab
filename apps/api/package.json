{
  "name": "@vocab/api",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://github.com/Muatasim-Aswad/vocab",
  "bugs": {
    "url": "https://github.com/Muatasim-Aswad/vocab/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muatasim-Aswad/vocab.git",
    "directory": "apps/api"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "scripts": {
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/migrate.js",
    "db:import:study-history": "node --env-file-if-exists=../../.env dist/import-study-history.js",
    "eval:one-word": "node --env-file-if-exists=../../.env evals/one-word/main.ts",
    "eval:meaning-match": "node --env-file-if-exists=../../.env evals/meaning-match/main.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@vocab/contracts": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "cookie": "^2.0.2",
    "drizzle-orm": "1.0.0-rc.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "1.0.0-rc.5",
    "supertest": "^7.3.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
