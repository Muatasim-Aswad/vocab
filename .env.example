# Shared Docker/development settings. Only the token is required; save in the root `.env`.
# Create a new token-only env file with: mise run setup
VOCAB_API_TOKEN=

# Optional overrides; uncomment only what you need to change.
# VOCAB_BIND=127.0.0.1
# VOCAB_PORT=3000
# Additional accepted hostnames; loopback names remain allowed.
# VOCAB_HOSTS=localhost
# Client URL override when the server is elsewhere.
# VOCAB_API_URL=http://127.0.0.1:3000

# Storage defaults: apps/api/data/vocab.db locally, /data/vocab.db inside Docker.
# Set a path appropriate to the environment you run in.
# VOCAB_DATABASE_PATH=

# Docker image override.
# VOCAB_IMAGE=vocab-api:local

# Private HTTPS proxy: set the external origin and host; adjust the binding if needed.
# VOCAB_PUBLIC_ORIGIN=https://vocab.example
# VOCAB_HOSTS=vocab.example

# Separate browser origin only; same-origin web access needs no CORS setting.
# VOCAB_CORS_ORIGINS=https://another.example

# Optional AI. Omit the model override to use the server's default.
# VOCAB_GEMINI_API_KEY=
# VOCAB_GEMINI_MODEL=

# API limits (defaults shown).
# VOCAB_AI_TIMEOUT_MS=90000
# VOCAB_AI_MAX_CONCURRENT=2
# VOCAB_BODY_LIMIT_BYTES=100000
# VOCAB_REQUEST_TIMEOUT_MS=10000
# VOCAB_MAX_CONCURRENT_REQUESTS=32
# VOCAB_SHUTDOWN_TIMEOUT_MS=10000
# VOCAB_LOG_LEVEL=log

# Local API only: serve a built web app instead of the Vite development server.
# VOCAB_WEB_ROOT=../web/dist
